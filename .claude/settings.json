{
  "permissions": {
    "allow": [
      "Bash(cargo run *)",
      "Bash(curl -sv http://127.0.0.1:4221/echo/abc)",
      "Bash(curl -sv http://127.0.0.1:4221/)",
      "Bash(curl -sv http://127.0.0.1:4221/nope)",
      "Bash(pkill -f target/debug/codecrafters-http-server)",
      "Bash(curl -s -o /dev/null -w \"/echo/abc/def -> %{http_code}\\\\n\" http://127.0.0.1:4221/echo/abc/def)",
      "Bash(curl -s -w \"\\\\n/echo/hello -> %{http_code}\\\\n\" http://127.0.0.1:4221/echo/hello)",
      "Bash(curl -s -o /dev/null -w \"/ -> %{http_code}\\\\n\" http://127.0.0.1:4221/)",
      "Bash(curl -s -o /dev/null -w \"/foo -> %{http_code}\\\\n\" http://127.0.0.1:4221/foo)",
      "Bash(curl -s -w \"\\\\n/echo/hello -> %{http_code}\\\\n\" -H \"User-Agent: testclient\" http://127.0.0.1:4221/echo/hello)",
      "Bash(curl -s -i http://127.0.0.1:4221/files/foo)",
      "Bash(curl -s -i http://127.0.0.1:4221/files/non_existant_file)",
      "Bash(curl -s -i --data \"12345\" -H \"Content-Type: application/octet-stream\" http://127.0.0.1:4221/files/file_123)",
      "Bash(curl -s -i http://127.0.0.1:4221/files/file_123)",
      "Bash(curl -s -i -H \"Accept-Encoding: gzip\" http://127.0.0.1:4221/echo/abc)",
      "Bash(curl -s -i http://127.0.0.1:4221/echo/abc)",
      "Bash(curl -s -i -H \"Accept-Encoding: br\" http://127.0.0.1:4221/echo/abc)",
      "Bash(curl -s -i -H \"Accept-Encoding: br, gzip\" http://127.0.0.1:4221/echo/abc)",
      "Bash(curl -s -i -H \"Accept-Encoding: gzip\" http://127.0.0.1:4221/echo/abc --output /tmp/gzip_resp.bin)",
      "Bash(curl -s --compressed -H \"Accept-Encoding: gzip\" http://127.0.0.1:4221/echo/abc)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
